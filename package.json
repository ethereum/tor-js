{
  "name": "tor-js",
  "version": "0.4.3",
  "description": "TypeScript Tor client using arti via WASM",
  "type": "module",
  "main": "dist/entryPoints/wasm-cdn/index.js",
  "types": "dist/entryPoints/wasm-cdn/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/entryPoints/wasm-cdn/index.d.ts",
      "import": "./dist/entryPoints/wasm-cdn/index.js"
    },
    "./wasm-cdn": {
      "types": "./dist/entryPoints/wasm-cdn/index.d.ts",
      "import": "./dist/entryPoints/wasm-cdn/index.js"
    },
    "./wasm-file": {
      "types": "./dist/entryPoints/wasm-file/index.d.ts",
      "import": "./dist/entryPoints/wasm-file/index.js"
    },
    "./wasm-base64": {
      "types": "./dist/entryPoints/wasm-base64/index.d.ts",
      "import": "./dist/entryPoints/wasm-base64/index.js"
    },
    "./singleton": {
      "types": "./dist/entryPoints/wasm-cdn/singleton.d.ts",
      "import": "./dist/entryPoints/wasm-cdn/singleton.js"
    },
    "./wasm-cdn/singleton": {
      "types": "./dist/entryPoints/wasm-cdn/singleton.d.ts",
      "import": "./dist/entryPoints/wasm-cdn/singleton.js"
    },
    "./wasm-file/singleton": {
      "types": "./dist/entryPoints/wasm-file/singleton.d.ts",
      "import": "./dist/entryPoints/wasm-file/singleton.js"
    },
    "./wasm-base64/singleton": {
      "types": "./dist/entryPoints/wasm-base64/singleton.d.ts",
      "import": "./dist/entryPoints/wasm-base64/singleton.js"
    }
  },
  "imports": {
    "#wasm": "./dist/wasm-pkg/tor_js.js",
    "#wasm-base64-data": "./dist/wasm-base64-data.js"
  },
  "files": [
    "dist",
    "src",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "scripts": {
    "build": "bash scripts/build.sh --release",
    "build:ts": "node build.mjs",
    "prepublishOnly": "npm run build",
    "clean": "rm -rf dist crates/tor-js-wasm/pkg target website/dist test/unit/.tmp-*.mjs test/anon-rpc-worker/.tmp-worker.js crates/tor-js-gateway/tests/browser/test-results",
    "website": "npm --prefix website run dev",

    "test": "npm run test:unit && npm run test:rust && node scripts/test-skipped.mjs",
    "test:unit": "node --test \"test/unit/*.test.mjs\"",
    "test:rust": "cargo test --locked && cargo test --locked -p tor-js",
    "test:integration": "cargo build --locked && cd crates/tor-js-gateway/tests/integration && npm ci && npm test",
    "test:browser": "cargo build --locked && cd crates/tor-js-gateway/tests/browser && npm ci && npx playwright install chromium && npm test",
    "test:worker": "cd test/anon-rpc-worker && npm ci && npx playwright install chromium && npm run test:hermetic",
    "test:live": "cd test/anon-rpc-worker && npm ci && npm run test:e2e && npm run test:stream-upload",
    "test:all": "npm run test && npm run test:integration && npm run test:browser && npm run test:worker && npm run test:live"
  },
  "author": "Andrew Morris",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ethereum/tor-js.git"
  },
  "homepage": "https://github.com/ethereum/tor-js",
  "bugs": {
    "url": "https://github.com/ethereum/tor-js/issues"
  },
  "devDependencies": {
    "@kpstreams/core": "^0.2.1",
    "@kpstreams/webrtc-client": "^0.2.1",
    "@types/node": "^25.3.0",
    "esbuild": "^0.25.12",
    "tsup": "^8.3.5",
    "typescript": "~5.7.3"
  },
  "peerDependencies": {
    "@kpstreams/quic-client": "^0.2.1"
  },
  "peerDependenciesMeta": {
    "@kpstreams/quic-client": {
      "optional": true
    }
  }
}
